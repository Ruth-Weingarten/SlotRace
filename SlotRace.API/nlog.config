<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- הפורמט של כל שורה: תאריך | רמה | מזהה בקשה (T20) | מחלקה | הודעה | חריגה (אם יש) -->
  <variable name="lineLayout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:item=CorrelationId} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

  <!-- יעדים: לאן לכתוב -->
  <targets>
    <target xsi:type="Console" name="console" layout="${lineLayout}" />
    <target xsi:type="File" name="file"
            fileName="logs/slotrace-${shortdate}.log"
            layout="${lineLayout}"
            maxArchiveFiles="7" />
  </targets>

  <!-- חוקים: מה לכתוב ולאן. נבדקים מלמעלה למטה; final="true" עוצר כאן -->
  <rules>
    <!-- "השרת עלה, מאזין בכתובת..." חשוב לראות -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    <!-- רעש של Microsoft ו-System (כמו שורות ה-dbug של EF): רק Warning ומעלה ממשיך -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <!-- כל השאר (הקוד שלנו): Info ומעלה, לקונסול ולקובץ -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
